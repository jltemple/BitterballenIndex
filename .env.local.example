# Copy this file to .env.local and fill in your values

# Public site URL (used for OG tags, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase — get from https://supabase.com/dashboard/project/<project>/settings/api
# Dashboard labels:  URL → Project URL
#                    NEXT_PUBLIC_SUPABASE_ANON_KEY → "publishable" key
#                    SUPABASE_SERVICE_ROLE_KEY      → "secret" key
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Admin auth
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH="$2a$10$placeholder"

# Random cookie secret: openssl rand -hex 32
ADMIN_COOKIE_SECRET=placeholder-cookie-secret-change-this

# Discord webhook for new bar announcements (optional)
# Create at: Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=

